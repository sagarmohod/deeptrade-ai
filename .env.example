# ==========================================
# DeepTrade AI — Environment Configuration
# ==========================================
# Copy to .env and fill in your values

# ---------- App ----------
APP_NAME=DeepTrade AI
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ---------- Mode ----------
# paper | backtest | live (live requires LIVE_TRADING_ENABLED=true)
MODE=paper
LIVE_TRADING_ENABLED=false   # MUST be true in env to enable live mode

# ---------- Database ----------
POSTGRES_USER=deeptrade
POSTGRES_PASSWORD=deeptrade_dev_password
POSTGRES_DB=deeptrade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://deeptrade:deeptrade_dev_password@localhost:5432/deeptrade

# TimescaleDB (same instance, different DB)
TIMESCALE_DB=deeptrade_timeseries
TIMESCALE_URL=postgresql+asyncpg://deeptrade:deeptrade_dev_password@localhost:5432/deeptrade_timeseries

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Zerodha Kite Connect ----------
# Get from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://localhost:8000/api/v1/auth/kite/callback
# Filled at runtime by daily login flow:
KITE_ACCESS_TOKEN=

# Algo tag (NSE compliance — required on every order)
ALGO_ID=personal_001

# ---------- Capital Configuration ----------
# Paper trading (always running)
PAPER_SIMULATED_CAPITAL=1000000   # ₹10L simulated for testing at scale

# Live trading (when enabled via UI)
LIVE_DEPLOYED_CAPITAL=15000        # ₹15K real money default
LIVE_REQUIRE_PAPER_VALIDATION=true # block live until 60d paper passes

# ---------- Risk Defaults (overridable via UI) ----------
DEFAULT_PER_TRADE_RISK_PCT=1.0
DEFAULT_DAILY_LOSS_LIMIT_PCT=3.0
DEFAULT_WEEKLY_LOSS_LIMIT_PCT=6.0
DEFAULT_MAX_CONCURRENT_POSITIONS=5

# ---------- LLM Endpoint ----------
# Your internal GPT wrapper (or OpenAI/Anthropic for testing)
LLM_BASE_URL=https://your-internal-gpt-endpoint.example.com
LLM_API_KEY=your_llm_token_here
LLM_MODEL=gpt-4

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Security ----------
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------- Observability ----------
PROMETHEUS_PORT=9090
ENABLE_METRICS=true
